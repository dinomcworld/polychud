{
  "name": "polychud",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts src/deploy-commands.ts src/scripts/cancelMarket.ts --target=bun --outdir=dist --minify --sourcemap=linked --production",
    "start": "bun dist/index.js",
    "deploy-commands": "bun src/deploy-commands.ts",
    "cancel-market": "bun src/scripts/cancelMarket.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "bun test ./e2e --preload ./e2e/setup.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx biome check --staged --no-errors-on-unmatched --write && git update-index --again"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@electric-sql/pglite": "^0.5.12",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "node-cron": "^4.6.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  }
}
